{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yugatn.github.io/ambivalent-solipsism/research/acn-schema.json",
  "title": "Associative Context Network Card Schema",
  "description": "Версия 2.0. Совместимая схема карточек Ассоциативно-контекстуальной сети. Разделяет источник, лакуну, контекст, основание связи, альтернативы и остаток неизвестного. Старые поля сохранены для совместимости.",
  "type": "object",
  "required": [
    "id",
    "source",
    "lacuna",
    "context",
    "status",
    "basis",
    "residual"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]*$"
    },
    "source": {
      "type": "object",
      "required": [
        "title",
        "medium"
      ],
      "properties": {
        "title": {
          "type": "string"
        },
        "medium": {
          "type": "string",
          "enum": [
            "film",
            "series",
            "book",
            "game",
            "other"
          ]
        },
        "year": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1800,
          "maximum": 2200
        },
        "author": {
          "type": [
            "string",
            "null"
          ]
        },
        "original_title": {
          "type": [
            "string",
            "null"
          ]
        },
        "relation_to_core": {
          "type": [
            "string",
            "null"
          ]
        },
        "mediator": {
          "type": [
            "string",
            "null"
          ]
        },
        "abstraction_level": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "empirical",
            "textual",
            "interpretive",
            "hypothetical",
            null
          ]
        }
      },
      "additionalProperties": false
    },
    "lacuna": {
      "type": "object",
      "required": [
        "question",
        "types"
      ],
      "properties": {
        "question": {
          "type": "string"
        },
        "types": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "enum": [
              "сюжетная",
              "психическая",
              "причинная",
              "онтологическая",
              "идентичностная",
              "темпоральная",
              "этическая",
              "технологическая",
              "космологическая",
              "текстовая",
              "интерпретационная",
              "личная",
              "остаточная"
            ]
          }
        }
      },
      "additionalProperties": false
    },
    "context": {
      "type": "object",
      "required": [
        "title",
        "transfer"
      ],
      "properties": {
        "title": {
          "type": "string"
        },
        "medium": {
          "type": "string",
          "enum": [
            "film",
            "series",
            "book",
            "game",
            "other"
          ]
        },
        "year": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1800,
          "maximum": 2200
        },
        "transfer": {
          "type": "string"
        },
        "effect": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "relation": {
      "type": "object",
      "properties": {
        "direction": {
          "type": "string"
        },
        "reversible": {
          "type": "boolean"
        },
        "type": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "link_type": {
          "type": [
            "string",
            "null"
          ]
        },
        "strength": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "low",
            "medium",
            "high",
            null
          ]
        },
        "epistemic_status": {
          "type": [
            "string",
            "null"
          ]
        },
        "causality": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "established",
            "not_established",
            "unknown",
            null
          ]
        },
        "basis": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "status": {
      "type": "string",
      "enum": [
        "канон",
        "авторское свидетельство",
        "интерпретация",
        "гипотеза",
        "личная ассоциация"
      ]
    },
    "basis": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "alternatives": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "counter_relation": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "epistemic_weight": {
      "type": "string",
      "enum": [
        "низкий",
        "средний",
        "высокий"
      ],
      "description": "Оценка качества основания, а не истинности самой связи."
    },
    "false_completeness_risk": {
      "type": "string",
      "enum": [
        "низкий",
        "средний",
        "высокий"
      ]
    },
    "residual": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "object",
          "required": [
            "primary_question"
          ],
          "properties": {
            "primary_question": {
              "type": "string"
            },
            "secondary_questions": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "note": {
              "type": "string"
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "clusters": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Тематические кластеры, к которым относится связь."
    },
    "atlas_ref": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string"
        },
        "note": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "created": {
      "type": "string",
      "format": "date"
    },
    "last_reviewed": {
      "type": "string",
      "format": "date"
    },
    "epistemic_status": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "canon",
        "documented",
        "interpretation",
        "hypothesis",
        "personal_association",
        "contested_evidence",
        null
      ]
    },
    "model_basis": {
      "type": [
        "string",
        "null"
      ]
    },
    "chain_basis": {
      "type": [
        "string",
        "null"
      ]
    },
    "referent": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "type": {
          "type": "string"
        },
        "name": {
          "type": "string"
        }
      },
      "required": [
        "type",
        "name"
      ],
      "additionalProperties": false
    },
    "causality": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "established",
        "not_established",
        "unknown",
        null
      ]
    },
    "contestation": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "absent",
        "present",
        "significant",
        null
      ]
    }
  },
  "additionalProperties": false,
  "schema_version": "2.0"
}
