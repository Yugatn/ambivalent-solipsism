{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["rule_id", "description", "when", "then"],
  "properties": {
    "rule_id": {"type": "string", "minLength": 1},
    "description": {"type": "string", "minLength": 1},
    "scope": {"type": "string"},
    "epistemic": {"type": "object", "additionalProperties": {"type": "string"}},
    "when": {"type": "object", "minProperties": 1, "additionalProperties": {}},
    "then": {
      "type": "object",
      "required": ["verdict", "severity"],
      "properties": {
        "verdict": {"enum": ["PASS", "REVIEW", "VIOLATION", "UNKNOWN"]},
        "severity": {"enum": ["low", "mid", "high", "irreversible"]},
        "levels": {"type": "array", "items": {"type": "string"}},
        "evidence": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}