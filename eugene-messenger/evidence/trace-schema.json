{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Eugene Messenger Attack Trace",
  "type": "object",
  "required": ["claim", "model", "violated_invariant", "trace", "falsification"],
  "properties": {
    "claim": {"type": "string"},
    "model": {"type": "string"},
    "violated_invariant": {"type": "string"},
    "trace": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["state", "action"],
        "properties": {
          "state": {"type": "integer", "minimum": 1},
          "action": {"type": "string"},
          "state_delta": {"type": "object"}
        },
        "additionalProperties": false
      }
    },
    "falsification": {"type": "string"}
  },
  "additionalProperties": false
}